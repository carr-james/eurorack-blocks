(version 1)

# Mill limits: 0.2mm isolation bit, unplated holes.
# Copy next to a board as <project>.kicad_dru. Board Setup minimums must match;
# custom rules can tighten but not loosen them.

(rule "minimum track width"
	(constraint track_width (min 0.2mm))
	(severity error))

(rule "minimum copper clearance"
	(constraint clearance (min 0.2mm))
	(severity error))

(rule "minimum via diameter"
	(constraint via_diameter (min 0.9mm))
	(severity error))

(rule "minimum drilled hole"
	(constraint hole_size (min 0.6mm))
	(severity error))

(rule "minimum annular ring"
	(constraint annular_width (min 0.15mm))
	(severity error))

(rule "hole to hole clearance"
	(constraint hole_to_hole (min 0.25mm))
	(severity error))

(rule "copper to hole clearance"
	(constraint hole_clearance (min 0.25mm))
	(severity error))

# Perimeter milling clears the edge already.
(rule "copper to board edge"
	(constraint edge_clearance (min 0mm))
	(severity ignore))
